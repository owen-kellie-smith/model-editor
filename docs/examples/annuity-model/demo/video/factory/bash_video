#!/usr/bin/env bash
set -euo pipefail
seconds_to_add=1

# ---- ordered list: filename | subtitle ----
files_in_order_with_captions=(
"loadXML.mp4|Load XML model"
"validatestep.mp4|Validate edits"
"depend.mp4|Explore dependencies"
"preview.mp4|Render results"
"excel.mp4|Run spreadsheet model"
"exportpython.mp4|Run Python model"
"pythonchart.mp4|View Python results"
)

concat_list="concat_list.txt"
output_file="final_output.mp4"
srt_file="final_output.srt"

: > "$concat_list"

clips=()

# ---- create _ext clips + concat list ----
for entry in "${files_in_order_with_captions[@]}"; do
    vid="${entry%%|*}"
    caption="${entry#*|}"

    clips+=("$vid")

    if [[ ! -f "$vid" ]]; then
        echo "Missing input file: $vid" >&2
        exit 1
    fi

    base="${vid%.mp4}"
    ext="${base}_ext.mp4"

    ffmpeg -y -i "$vid" \
        -vf "fps=30,tpad=stop_mode=clone:stop_duration=$seconds_to_add" \
        -an -c:v libx264 -pix_fmt yuv420p \
        "$ext"

    printf "file '%s'\n" "$ext" >> "$concat_list"
done

# ---- concatenate ----
ffmpeg -y -f concat -safe 0 -i "$concat_list" -c copy "$output_file"

# ---- generate SRT ----
python3 - "$srt_file" "${files_in_order_with_captions[@]}" <<'PY'
import sys, subprocess

out_srt = sys.argv[1]
entries = sys.argv[2:]

def ffprobe_duration(path: str) -> float:
    cmd = [
        "ffprobe","-v","error",
        "-show_entries","format=duration",
        "-of","default=noprint_wrappers=1:nokey=1",
        path
    ]
    return float(subprocess.check_output(cmd,text=True).strip())

def srt_time(t: float) -> str:
    ms_total=int(round(t*1000))
    h=ms_total//3600000
    ms_total%=3600000
    m=ms_total//60000
    ms_total%=60000
    s=ms_total//1000
    ms=ms_total%1000
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"

timeline=0.0
idx=1
lines=[]

for entry in entries:
    vid,caption=entry.split("|",1)

    base=vid[:-4] if vid.endswith(".mp4") else vid
    ext=f"{base}_ext.mp4"

    dur=ffprobe_duration(ext)

    start=timeline+0.1
    end=timeline+dur-0.1
    if end<=start:
        end=start+0.001

    lines.append(str(idx))
    lines.append(f"{srt_time(start)} --> {srt_time(end)}")
    lines.append(caption)
    lines.append("")

    timeline+=dur
    idx+=1

with open(out_srt,"w") as f:
    f.write("\n".join(lines))

print(f"Wrote {out_srt}")
PY

rm *_ext.mp4


input_video="final_output.mp4"
input_sub="final_output.srt"
output_video="../overview_final.mp4"
output_gif="../demo.gif"
filter_file="burn_subs.filt"

# Create filter script WITH variable expansion
cat > "$filter_file" <<EOF
subtitles='${input_sub}':force_style='Fontname=Arial,Fontsize=28,PrimaryColour=&H00FFFFFF&,BackColour=&H00000000&,BorderStyle=3,Outline=2,Shadow=0,Alignment=2,MarginV=18'
EOF

ffmpeg -y -i "$input_video" \
  -filter_complex_script "$filter_file" \
  -c:v libx264 -pix_fmt yuv420p -c:a copy \
  "$output_video"

# 1. generate palette
ffmpeg -y -i "$output_video" -vf "fps=12,scale=900:-1:flags=lanczos,palettegen" palette.png

# 2. create GIF using palette
ffmpeg -y -i "$output_video" -i palette.png \
  -lavfi "fps=12,scale=900:-1:flags=lanczos[x];[x][1:v]paletteuse" \
  "$output_gif"

# clean up
rm palette.png
rm $filter_file
rm $input_sub
rm $concat_list
rm $input_video
