#!/usr/bin/env bash
set -euo pipefail

input_video="final_output.mp4"
input_sub="final_output.srt"
output_video="../overview_final.mp4"
output_gif="../demo.gif"
filter_file="burn_subs.filt"

# Create filter script WITH variable expansion
cat > "$filter_file" <<EOF
subtitles='${input_sub}':force_style='Fontname=Arial,Fontsize=28,PrimaryColour=&H00FFFFFF&,BackColour=&H00000000&,BorderStyle=3,Outline=2,Shadow=0,Alignment=2,MarginV=18'
EOF

ffmpeg -y -i "$input_video" \
  -filter_complex_script "$filter_file" \
  -c:v libx264 -pix_fmt yuv420p -c:a copy \
  "$output_video"

# 1. generate palette
ffmpeg -y -i "$output_video" -vf "fps=12,scale=900:-1:flags=lanczos,palettegen" palette.png

# 2. create GIF using palette
ffmpeg -y -i "$output_video" -i palette.png \
  -lavfi "fps=12,scale=900:-1:flags=lanczos[x];[x][1:v]paletteuse" \
  "$output_gif"
