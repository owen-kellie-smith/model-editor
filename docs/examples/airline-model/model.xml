<?xml version="1.0" encoding="UTF-8"?>

<model id="airline-profitability">

  <!-- ================= -->
  <!-- Index sets        -->
  <!-- ================= -->

  <indexSets>

    <indexSet id="month">
      <description>Projection month</description>
      <dataType>integer</dataType>
    </indexSet>

    <indexSet id="route_class">
      <description>Route and class combination</description>
      <dataType>string</dataType>
    </indexSet>

  </indexSets>


  <!-- ================= -->
  <!-- Units             -->
  <!-- ================= -->

  <units>

    <unit id="USD"/>
    <unit id="USD_per_month"/>
    <unit id="percent"/>
    <unit id="passengers"/>
    <unit id="seats"/>
    <unit id="flights"/>
    <unit id="hours"/>
    <unit id="miles"/>

  </units>


  <!-- ================= -->
  <!-- Variables         -->
  <!-- ================= -->

  <variables>

    <!-- Fleet & Operations -->
    
    <variable id="aircraft_count">
      <dataType>integer</dataType>
      <definition type="constant">
        10
      </definition>
    </variable>

    <variable id="seats_per_aircraft">
      <dataType>integer</dataType>
      <unit>seats</unit>
      <definition type="constant">
        180
      </definition>
    </variable>

    <variable id="flights_per_aircraft_per_month">
      <dataType>integer</dataType>
      <unit>flights</unit>
      <definition type="constant">
        120
      </definition>
    </variable>

    <variable id="avg_flight_distance">
      <dataType>real</dataType>
      <unit>miles</unit>
      <definition type="constant">
        850
      </definition>
    </variable>

    <variable id="avg_flight_time">
      <dataType>real</dataType>
      <unit>hours</unit>
      <definition type="constant">
        2.5
      </definition>
    </variable>

    <!-- Load Factors & Pricing -->

    <variable id="economy_seats_percent">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="constant">
        0.80
      </definition>
    </variable>

    <variable id="business_seats_percent">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="constant">
        0.15
      </definition>
    </variable>

    <variable id="first_seats_percent">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="constant">
        0.05
      </definition>
    </variable>

    <variable id="economy_load_factor">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="constant">
        0.85
      </definition>
    </variable>

    <variable id="business_load_factor">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="constant">
        0.70
      </definition>
    </variable>

    <variable id="first_load_factor">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="constant">
        0.60
      </definition>
    </variable>

    <variable id="economy_ticket_price">
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="constant">
        250
      </definition>
    </variable>

    <variable id="business_ticket_price">
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="constant">
        800
      </definition>
    </variable>

    <variable id="first_ticket_price">
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="constant">
        1500
      </definition>
    </variable>

    <!-- Capacity Calculations -->

    <variable id="total_monthly_flights">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>integer</dataType>
      <unit>flights</unit>
      <definition type="expression">
        aircraft_count * flights_per_aircraft_per_month
      </definition>
    </variable>

    <variable id="economy_seats_per_flight">
      <dataType>real</dataType>
      <unit>seats</unit>
      <definition type="expression">
        seats_per_aircraft * economy_seats_percent
      </definition>
    </variable>

    <variable id="business_seats_per_flight">
      <dataType>real</dataType>
      <unit>seats</unit>
      <definition type="expression">
        seats_per_aircraft * business_seats_percent
      </definition>
    </variable>

    <variable id="first_seats_per_flight">
      <dataType>real</dataType>
      <unit>seats</unit>
      <definition type="expression">
        seats_per_aircraft * first_seats_percent
      </definition>
    </variable>

    <!-- Passenger Volumes -->

    <variable id="economy_passengers_per_flight">
      <dataType>real</dataType>
      <unit>passengers</unit>
      <definition type="expression">
        economy_seats_per_flight * economy_load_factor
      </definition>
    </variable>

    <variable id="business_passengers_per_flight">
      <dataType>real</dataType>
      <unit>passengers</unit>
      <definition type="expression">
        business_seats_per_flight * business_load_factor
      </definition>
    </variable>

    <variable id="first_passengers_per_flight">
      <dataType>real</dataType>
      <unit>passengers</unit>
      <definition type="expression">
        first_seats_per_flight * first_load_factor
      </definition>
    </variable>

    <variable id="total_passengers_per_flight">
      <dataType>real</dataType>
      <unit>passengers</unit>
      <definition type="expression">
        economy_passengers_per_flight + business_passengers_per_flight + first_passengers_per_flight
      </definition>
    </variable>

    <!-- Revenue -->

    <variable id="monthly_economy_revenue">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        economy_passengers_per_flight * economy_ticket_price * total_monthly_flights(month)
      </definition>
    </variable>

    <variable id="monthly_business_revenue">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        business_passengers_per_flight * business_ticket_price * total_monthly_flights(month)
      </definition>
    </variable>

    <variable id="monthly_first_revenue">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        first_passengers_per_flight * first_ticket_price * total_monthly_flights(month)
      </definition>
    </variable>

    <variable id="monthly_total_revenue">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        monthly_economy_revenue(month) + monthly_business_revenue(month) + monthly_first_revenue(month)
      </definition>
    </variable>

    <!-- Operating Costs -->

    <variable id="fuel_cost_per_mile">
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="constant">
        2.5
      </definition>
    </variable>

    <variable id="crew_cost_per_flight">
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="constant">
        1200
      </definition>
    </variable>

    <variable id="maintenance_cost_per_flight">
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="constant">
        800
      </definition>
    </variable>

    <variable id="landing_fees_per_flight">
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="constant">
        500
      </definition>
    </variable>

    <variable id="monthly_lease_cost">
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="constant">
        400000
      </definition>
    </variable>

    <variable id="monthly_admin_cost">
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="constant">
        150000
      </definition>
    </variable>

    <variable id="monthly_marketing_cost">
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="constant">
        50000
      </definition>
    </variable>

    <!-- Debt & Interest -->

    <variable id="annual_interest_rate">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="constant">
        0.06
      </definition>
    </variable>

    <variable id="initial_debt">
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="constant">
        5000000
      </definition>
    </variable>

    <variable id="monthly_fuel_cost">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        fuel_cost_per_mile * avg_flight_distance * total_monthly_flights(month)
      </definition>
    </variable>

    <variable id="monthly_crew_cost">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        crew_cost_per_flight * total_monthly_flights(month)
      </definition>
    </variable>

    <variable id="monthly_maintenance_cost">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        maintenance_cost_per_flight * total_monthly_flights(month)
      </definition>
    </variable>

    <variable id="monthly_landing_fees">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        landing_fees_per_flight * total_monthly_flights(month)
      </definition>
    </variable>

    <variable id="monthly_variable_costs">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        monthly_fuel_cost(month) + monthly_crew_cost(month) + monthly_maintenance_cost(month) + monthly_landing_fees(month)
      </definition>
    </variable>

    <variable id="monthly_fixed_costs">
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        monthly_lease_cost + monthly_admin_cost + monthly_marketing_cost
      </definition>
    </variable>

    <variable id="monthly_total_costs">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        monthly_variable_costs(month) + monthly_fixed_costs
      </definition>
    </variable>

    <!-- Profitability -->

    <variable id="monthly_net_profit">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        monthly_total_revenue(month) - monthly_total_costs(month)
      </definition>
    </variable>

    <variable id="monthly_profit_margin">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="expression">
        monthly_net_profit(month) / monthly_total_revenue(month)
      </definition>
    </variable>

    <!-- Time-varying profitability: debt repayment and interest costs -->

    <variable id="monthly_interest_rate">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="expression">
        annual_interest_rate / 12
      </definition>
    </variable>

    <variable id="outstanding_debt">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD</unit>
      <definition type="piecewise">
        <case>
          <when>month = 0</when>
          <value>initial_debt</value>
        </case>
        <case>
          <when>month &gt; 0</when>
          <value>max(0, outstanding_debt(month - 1) - monthly_net_profit_after_interest(month - 1))</value>
        </case>
      </definition>
    </variable>

    <variable id="monthly_interest_cost">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        outstanding_debt(month) * monthly_interest_rate
      </definition>
    </variable>

    <variable id="monthly_net_profit_after_interest">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>USD_per_month</unit>
      <definition type="expression">
        monthly_net_profit(month) - monthly_interest_cost(month)
      </definition>
    </variable>

    <variable id="monthly_profit_margin_after_interest">
      <arguments>
        <arg indexSet="month"/>
      </arguments>
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="expression">
        monthly_net_profit_after_interest(month) / monthly_total_revenue(month)
      </definition>
    </variable>

  </variables>

</model>
