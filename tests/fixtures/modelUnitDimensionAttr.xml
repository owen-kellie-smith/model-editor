<?xml version="1.0" encoding="UTF-8"?>

<!-- Model that uses the dimension attribute on <unit> elements to group
     model-specific units into the same dimension.  The sum of 'rate_pct'
     (unit: percent) and 'base_rate' (unit: bps — basis points) should be
     accepted because both units carry  dimension="rate". -->
<model id="test-unit-dimension-attr">

  <units>
    <unit id="percent" dimension="rate"/>
    <unit id="bps"     dimension="rate"/>
    <unit id="GBP"/>
  </units>

  <variables>

    <variable id="rate_pct">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="constant">2.5</definition>
    </variable>

    <variable id="spread_bps">
      <dataType>real</dataType>
      <unit>bps</unit>
      <definition type="constant">50</definition>
    </variable>

    <!-- percent + bps — both have dimension="rate", should be accepted -->
    <variable id="total_rate">
      <dataType>real</dataType>
      <unit>percent</unit>
      <definition type="expression">
        rate_pct + spread_bps
      </definition>
    </variable>

  </variables>

</model>
