<?xml version="1.0" encoding="UTF-8"?>

<!-- Model whose 'nonsense_sum' variable adds a time variable to a currency
     variable.  This should fail the dimensional-consistency check. -->
<model id="test-unit-mismatch">

  <units>
    <unit id="years"/>
    <unit id="GBP"/>
  </units>

  <variables>

    <variable id="time_in_years">
      <dataType>real</dataType>
      <unit>years</unit>
      <definition type="constant">10</definition>
    </variable>

    <variable id="amount_in_GBP">
      <dataType>real</dataType>
      <unit>GBP</unit>
      <definition type="constant">100</definition>
    </variable>

    <!-- years + GBP — unit mismatch, should be rejected -->
    <variable id="nonsense_sum">
      <dataType>real</dataType>
      <unit>years</unit>
      <definition type="expression">
        time_in_years + amount_in_GBP
      </definition>
    </variable>

  </variables>

</model>
